---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Modes from '../components/Modes.astro';
import Widgets from '../components/Widgets.astro';
import Bento from '../components/Bento.astro';
import Safety from '../components/Safety.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="DockHub · Modern Dock & Widgets for Windows"
  description="A modern, glassmorphic, widget-powered dock that replaces or enhances the Windows taskbar. Free, lightweight, and open source. Try the live interactive demo right in your browser."
>
  <Nav />
  <main id="content">
    <Hero />
    <Modes />
    <Widgets />
    <Bento />
    <Safety />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
