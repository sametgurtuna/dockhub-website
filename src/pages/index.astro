---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Modes from '../components/Modes.astro';
import WhatsNew from '../components/WhatsNew.astro';
import Widgets from '../components/Widgets.astro';
import Shots from '../components/Shots.astro';
import Bento from '../components/Bento.astro';
import Safety from '../components/Safety.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="DockHub 1.0 · Modern Glassy Dock for Windows & macOS"
  description="A modern, glassy, widget-powered dock for Windows 10/11 and macOS 15+ Sequoia. Features 30+ live widgets, Web Widgets SDK 1.0, and zero admin rights required. Free and open source."
>
  <Nav />
  <main id="content">
    <Hero />
    <WhatsNew />
    <Modes />
    <Widgets />
    <Shots />
    <Bento />
    <Safety />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
