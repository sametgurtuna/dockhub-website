---
import Wordmark from './Wordmark.astro';
import { icons } from '../lib/icons';
import { site } from '../lib/site';

const links = [
  { href: '#demo', label: 'Demo' },
  { href: '#widgets', label: 'Widgets' },
  { href: '#shots', label: 'Screenshots' },
  { href: '#features', label: 'Features' },
  { href: '#safety', label: 'Safety' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href="#top" aria-label="DockHub home">
      <Wordmark label={false} />
    </a>
    <nav class="nav-links" aria-label="Page sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="nav-gh" href={site.githubUrl} aria-label="GitHub repository" set:html={icons.github} />
      <a class="btn btn-primary nav-dl" href={site.downloadUrl}>
        <span set:html={icons.windows} />
        <span>Download</span>
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background-color var(--t-slow) var(--ease-out),
      box-shadow var(--t-slow) var(--ease-out);
  }
  .nav.is-scrolled {
    background: rgb(7 8 12 / 0.72);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: 0 1px 0 var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 1.5rem;
    text-decoration: none;
    border-radius: 6px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .nav-links a {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 540;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }
  .nav-links a:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-gh {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: var(--text-2);
    transition: color var(--t-fast), background-color var(--t-fast);
  }
  .nav-gh:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  .nav-gh :global(svg) {
    width: 20px;
    height: 20px;
  }
  .nav-dl {
    --btn-h: 38px;
    padding-inline: 14px;
    font-size: 0.9375rem;
  }
  .nav-dl span:first-child {
    width: 15px;
    height: 15px;
    display: grid;
  }
  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .nav-actions {
      margin-left: auto;
    }
  }
</style>
