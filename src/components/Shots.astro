---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface Shot {
  file: string;
  w: number;
  h: number;
  title: string;
  body: string;
  span?: 'hero' | 'wide';
}

const shots: Shot[] = [
  {
    file: 'dock-overview.jpg',
    w: 1600,
    h: 900,
    title: 'The dock, on a real desktop',
    body: 'Pinned apps, a sticky note, headset battery, media controls, a clock, AI usage rings, an app folder and live weather. All in one bar.',
    span: 'hero',
  },
  {
    file: 'widget-gallery.jpg',
    w: 1400,
    h: 788,
    title: 'Widget gallery',
    body: 'Every widget previewed live with its real data. Press the plus button and it grows into the dock.',
    span: 'wide',
  },
  {
    file: 'groups-folder.jpg',
    w: 770,
    h: 460,
    title: 'Folders that fan open',
    body: 'Drag any two items together to make a folder. Click it to expand, then rename it or give it a color.',
  },
  {
    file: 'window-preview.jpg',
    w: 1000,
    h: 520,
    title: 'Live window previews',
    body: 'Hover a running app for a real thumbnail of its window, with a close button right there.',
  },
  {
    file: 'jump-list.jpg',
    w: 900,
    h: 420,
    title: 'Jump Lists',
    body: 'Right-click an app for its recent files and tasks, plus run as administrator and pin controls.',
  },
  {
    file: 'start-menu.jpg',
    w: 1400,
    h: 788,
    title: 'The real Start menu',
    body: 'The Start button opens the genuine Windows Start menu. Search and the Windows key work exactly as before.',
  },
  {
    file: 'light-vertical.jpg',
    w: 1400,
    h: 788,
    title: 'Light theme, vertical dock',
    body: 'Move the dock to any edge. On the left or right, widgets collapse into compact tiles.',
  },
  {
    file: 'settings.jpg',
    w: 1400,
    h: 788,
    title: 'Settings for everything',
    body: 'Theme, glass, tint, size, shape, edge margin, width, alignment, screen edge and monitor.',
  },
  {
    file: 'explorer-pin.jpg',
    w: 1400,
    h: 788,
    title: 'Pin from File Explorer',
    body: 'Right-click any program or shortcut and send it straight to the dock.',
  },
];
---

<section class="section" id="shots">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">Real screenshots, not mockups.</h2>
      <p class="section-lead">
        Every image below is DockHub running on Windows 11. Click any shot to see it full size.
      </p>
    </div>

    <div class="shot-grid">
      {
        shots.map((s) => (
          <figure class:list={['shot', 'reveal', s.span && `shot-${s.span}`]}>
            <button class="shot-view" type="button" data-shot={`${base}shots/${s.file}`} data-shot-title={s.title} aria-label={`${s.title}: view full size`}>
              <img src={`${base}shots/${s.file}`} width={s.w} height={s.h} loading="lazy" decoding="async" alt={s.title} />
            </button>
            <figcaption>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<dialog class="shot-modal" data-shot-modal aria-label="Screenshot viewer">
  <button class="shot-close" type="button" data-shot-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
      ><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path></svg
    >
  </button>
  <img data-shot-img alt="" />
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-shot-modal]');
  const img = document.querySelector<HTMLImageElement>('[data-shot-img]');
  if (modal && img) {
    document.querySelectorAll<HTMLButtonElement>('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.shot ?? '';
        img.alt = btn.dataset.shotTitle ?? '';
        modal.showModal();
      });
    });
    modal.querySelector('[data-shot-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    modal.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .shot-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 26px);
  }
  .shot {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: 0;
    min-width: 0;
    border-radius: 24px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .shot-hero {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-rows: auto;
    align-items: center;
  }
  .shot-wide {
    grid-column: span 2;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    grid-template-rows: auto;
    align-items: center;
  }
  .shot-wide .shot-view {
    padding: 12px;
  }
  .shot-wide figcaption {
    padding: 20px 32px 20px 12px;
  }
  .shot-view {
    display: block;
    width: 100%;
    padding: 12px 12px 0;
    cursor: zoom-in;
    border-radius: 12px;
  }
  .shot-hero .shot-view {
    padding: 16px;
  }
  .shot-view img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: radial-gradient(90% 80% at 50% 110%, rgb(0 103 192 / 0.18), transparent 70%), #060911;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform var(--t-slow) var(--ease-out),
      box-shadow var(--t-slow) var(--ease-out);
  }
  .shot:not(.shot-hero) .shot-view img {
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }
  .shot-view:hover img {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 18px 40px -24px rgb(0 0 0 / 0.9);
  }
  .shot-view:focus-visible {
    outline: none;
  }
  .shot-view:focus-visible img {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  figcaption {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 18px 22px 24px;
  }
  .shot-hero figcaption {
    padding: 24px 40px 24px 12px;
  }
  figcaption h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }
  .shot-hero figcaption h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.875rem);
    line-height: 1.12;
    letter-spacing: -0.028em;
  }
  figcaption p {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 52ch;
  }
  .shot-hero figcaption p {
    font-size: 1.0625rem;
  }
  :global(:root:has(.shot-modal[open])) {
    overflow: hidden;
  }

  .shot-modal {
    width: min(94vw, 1500px);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 16px;
    background: transparent;
    overflow: visible;
  }
  .shot-modal::backdrop {
    background: rgb(2 4 10 / 0.82);
    backdrop-filter: blur(6px);
  }
  .shot-modal img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 16px;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 40px 120px -40px rgb(0 0 0 / 0.9);
  }
  .shot-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .shot-close:hover {
    background: rgb(255 255 255 / 0.2);
  }
  .shot-close svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1080px) {
    .shot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shot-wide {
      grid-column: auto;
      grid-template-columns: none;
      grid-template-rows: auto 1fr;
      align-items: stretch;
    }
    .shot-wide .shot-view {
      padding: 12px 12px 0;
    }
    .shot-wide figcaption {
      padding: 18px 22px 24px;
    }
  }
  @media (max-width: 760px) {
    .shot-grid {
      grid-template-columns: 1fr;
    }
    .shot-hero {
      grid-template-columns: 1fr;
    }
    .shot-hero .shot-view {
      padding: 12px 12px 0;
    }
    .shot-hero figcaption {
      padding: 18px 22px 24px;
    }
    .shot-close {
      top: 8px;
      right: 8px;
    }
  }
</style>
