---
import { dockLogo } from '../lib/icons';

interface Props {
  class?: string;
  label?: boolean;
  id?: string;
}
const { class: className = '', label = true, id = 'wm' } = Astro.props;
---

<span class:list={['wordmark', className]} role={label ? 'img' : undefined} aria-label={label ? 'DockHub' : undefined} aria-hidden={label ? undefined : 'true'}>
  <span class="wm-mark" set:html={dockLogo(`${id}-mark`)} />
  <span class="wm-text">DockHub</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    color: var(--text);
  }
  .wm-mark {
    display: grid;
    width: 1.75em;
    height: 1.75em;
    flex: none;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.45));
  }
  .wm-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
