---
import Bloom from './Bloom.astro';
import { dockLogo, icons } from '../lib/icons';
import { site } from '../lib/site';
---

<section class="section cta-section" id="download">
  <div class="wrap">
    <div class="cta reveal">
      <Bloom id="bloom-cta" class="cta-bloom" />
      <div class="cta-inner">
        <span class="cta-mark" set:html={dockLogo('cta-mark')} />
        <h2 class="cta-title">Make your desktop feel like home.</h2>
        <p class="cta-lead">
          Free, never asks for administrator rights, and your original taskbar is always one click away.
        </p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={site.downloadWinUrl}>
            <span class="btn-ic" set:html={icons.windows} />
            <span>Download for Windows</span>
          </a>
          <a class="btn btn-glass" href={site.downloadMacUrl}>
            <span class="btn-ic" set:html={icons.apple} />
            <span>Download for macOS</span>
          </a>
          <a class="btn btn-quiet" href={site.githubUrl} target="_blank" rel="noopener">
            <span class="btn-ic" set:html={icons.github} />
            <span>GitHub</span>
          </a>
        </div>
        <p class="cta-fine">
          <span>Version {site.version}</span>
          <span>Windows 10/11 (.NET 10)</span>
          <span>macOS 15+ Sequoia (Swift 6)</span>
          <span>Zero admin rights</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 28px;
    min-height: clamp(460px, 44vw, 580px);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-stage);
  }
  .cta :global(.cta-bloom) {
    z-index: -1;
  }
  .cta :global(.cta-bloom .bloom-breathe) {
    transform-origin: 50% 90%;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(58% 58% at 50% 44%, rgb(2 6 18 / 0.78), rgb(2 6 18 / 0.12) 72%);
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    padding: clamp(48px, 7vw, 80px) 24px;
  }
  .cta-mark {
    display: grid;
    width: 64px;
    height: 64px;
    margin-bottom: 6px;
    filter: drop-shadow(0 16px 30px rgb(0 0 0 / 0.6));
  }
  .cta-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .cta-title {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 12ch;
    text-shadow: 0 4px 40px rgb(0 10 40 / 0.6);
  }
  .cta-lead {
    max-width: 40ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    color: rgb(226 234 250 / 0.86);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
  .cta-actions .btn {
    --btn-h: 52px;
    padding-inline: 24px;
  }
  .btn-ic {
    display: grid;
    width: 18px;
    height: 18px;
  }
  .btn-ic :global(svg) {
    width: 100%;
    height: 100%;
  }
  .btn-primary .btn-ic :global(svg) {
    stroke-width: 2;
  }
  .cta-fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 0;
    font-size: 0.875rem;
    color: rgb(206 220 246 / 0.74);
  }
  .cta-fine span {
    white-space: nowrap;
  }
  .cta-fine span + span::before {
    content: '·';
    margin-inline: 8px;
  }

  @media (max-width: 560px) {
    .cta-actions {
      width: 100%;
    }
    .cta-actions .btn {
      flex: 1 1 100%;
    }
    .cta-fine {
      flex-direction: column;
    }
    .cta-fine span + span::before {
      content: none;
    }
  }
</style>
