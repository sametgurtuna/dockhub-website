---
import Bloom from './Bloom.astro';
import Wordmark from './Wordmark.astro';
import { icons } from '../lib/icons';
import { site } from '../lib/site';
---

<section class="section cta-section" id="indir">
  <div class="wrap">
    <div class="cta reveal">
      <Bloom id="bloom-cta" class="cta-bloom" />
      <div class="cta-inner">
        <Wordmark class="cta-logo" />
        <h2 class="cta-title">Masaüstünü evin yap.</h2>
        <p class="cta-lead">Ücretsiz, açık kaynak ve yönetici izni istemez. Beğenmezsen tek tıkla eski görev çubuğuna dönersin.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={site.downloadUrl}>
            <span set:html={icons.windows} />
            Ücretsiz indir (v0.3.1)
          </a>
          <button class="btn-terminal" type="button" data-copy-cmd="winget install DockHub" aria-label="Terminal komutunu kopyala">
            <span class="prompt">&gt;</span>
            <code>winget install DockHub</code>
            <span class="copy-ic" set:html={icons.copy} />
          </button>
          <a class="btn btn-glass" href={site.githubUrl} target="_blank" rel="noopener">
            <span set:html={icons.github} />
            GitHub
          </a>
        </div>
        <p class="cta-fine">Windows 10 ve 11 · Kurulum gereken her şeyi içerir · Açık kaynak & ücretsiz</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#indir [data-copy-cmd]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.copyCmd;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        btn.classList.add('is-copied');
        const copyIc = btn.querySelector('.copy-ic');
        if (copyIc) {
          copyIc.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;
        }
        setTimeout(() => {
          btn.classList.remove('is-copied');
          if (copyIc) {
            copyIc.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"/></svg>`;
          }
        }, 2000);
      } catch {}
    });
  });
</script>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 32px;
    min-height: clamp(460px, 48vw, 620px);
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 60px 140px -60px rgb(24 104 255 / 0.7);
  }
  .cta :global(.cta-bloom) {
    z-index: -1;
  }
  .cta :global(.cta-bloom .bloom-breathe) {
    transform-origin: 50% 90%;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 42%, rgb(2 6 18 / 0.72), rgb(2 6 18 / 0.1) 70%);
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    padding: clamp(48px, 7vw, 80px) 24px;
  }
  .cta :global(.cta-logo) {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 6px;
    filter: drop-shadow(0 12px 30px rgb(0 0 0 / 0.6));
  }
  .cta-title {
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 12ch;
    text-shadow: 0 4px 40px rgb(0 10 40 / 0.6);
  }
  .cta-lead {
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    color: rgb(230 238 255 / 0.86);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .cta-actions .btn {
    --btn-h: 54px;
    padding-inline: 26px;
    font-size: 1.0625rem;
  }
  .cta-actions .btn span {
    width: 18px;
    height: 18px;
    display: grid;
  }
  .cta-fine {
    font-size: 0.875rem;
    color: rgb(214 226 250 / 0.72);
  }
</style>
