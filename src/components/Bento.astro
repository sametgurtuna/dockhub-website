---
import MiniStage from './MiniStage.astro';
import { icons } from '../lib/icons';
import { appIcons } from '../lib/apps';

const cursor = `<svg viewBox="0 0 18 22"><path d="M1.5 1.5v16.2l4.2-4 2.9 6.6 3-1.3-2.9-6.5h5.8z" fill="#fff" stroke="#111" stroke-width="1.2" stroke-linejoin="round"/></svg>`;
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">The little details, perfected.</h2>
      <p class="section-lead">Everything you expect from a taskbar, elevated with the comfort and fluidity of a modern dock.</p>
    </div>

    <div class="bento">
      <article class="card card-wide reveal" data-card>
        <div class="card-copy">
          <h3>Any screen edge.</h3>
          <p>Bottom, top, left, or right. On vertical edges, widgets adapt into compact pills displaying key values at a glance.</p>
          <div class="edge-opts" aria-hidden="true">
            <span data-edge-opt="bottom" class="on">Bottom</span>
            <span data-edge-opt="left">Left</span>
            <span data-edge-opt="top">Top</span>
            <span data-edge-opt="right">Right</span>
          </div>
        </div>
        <div class="card-art art-tall">
          <MiniStage
            id="bloom-b-edge"
            cycle="edge"
            label="Dock cycling through bottom, left, top, and right screen edges"
            spec="start app:explorer app:browser sep w:clock:analog w:weather:current w:status:rings tray clock"
          />
        </div>
      </article>

      <article class="card reveal" data-card>
        <div class="card-art">
          <MiniStage id="bloom-b-hide" cycle="autohide" size="large" bloomScale={1.9} bloomOrigin="50% 95%" hue={-18} label="Dock auto-hiding and sliding back when cursor hits screen edge" spec="app:explorer sep w:clock:digital w:system:numbers">
            <span class="mini-cursor" data-cursor set:html={cursor} />
          </MiniStage>
        </div>
        <div class="card-copy">
          <h3>Tucks away when not needed.</h3>
          <p>Auto-hide glides the dock off-screen until you hover the edge. Automatically hides during full-screen games, videos, and F11 mode.</p>
        </div>
      </article>

      <article class="card reveal" data-card>
        <div class="card-art">
          <MiniStage id="bloom-b-pin" cycle="pin" size="large" bloomScale={2.4} bloomOrigin="25% 30%" hue={12} label="Pinning to DockHub from File Explorer context menu" spec="app:explorer app:browser app:terminal">
            <div class="pin-menu" data-pin-menu>
              <div class="pin-file"><span set:html={appIcons.calculator} />Calculator.lnk</div>
              <div class="flyout menu">
                <div class="menu-item"><span class="mi-ic" set:html={icons.external} /><span class="mi-label">Open</span></div>
                <div class="menu-item pin-target"><span class="mi-ic" set:html={icons.pin} /><span class="mi-label">Pin to DockHub</span></div>
              </div>
            </div>
          </MiniStage>
        </div>
        <div class="card-copy">
          <h3>Pin straight from Explorer.</h3>
          <p>Right-click any .exe or shortcut and select "Pin to DockHub". Or simply drag and drop running applications directly onto the dock.</p>
        </div>
      </article>

      <article class="card reveal" data-card>
        <div class="card-art">
          <MiniStage id="bloom-b-tray" layout="attached" size="large" bloomScale={2.8} bloomOrigin="85% 85%" hue={-8} label="System tray on the dock and hidden icons flyout" spec="w:media:mini tray clock" class="tray-mini">
            <div class="flyout tray-fly">
              <div class="tray-grid">
                <span class="tg" set:html={appIcons.music} />
                <span class="tg" set:html={appIcons.photos} />
                <span class="tg" set:html={appIcons.calculator} />
                <span class="tg" set:html={appIcons.terminal} />
              </div>
            </div>
          </MiniStage>
        </div>
        <div class="card-copy">
          <h3>Your tray icons, right in place.</h3>
          <p>Active app icons sit cleanly on the dock, overflow apps rest inside the arrow flyout. Your existing Windows tray preferences are imported seamlessly.</p>
        </div>
      </article>

      <article class="card reveal" data-card>
        <div class="card-art">
          <MiniStage id="bloom-b-vert" edge="left" size="medium" panel="weather" bloomScale={1.7} bloomOrigin="0% 45%" hue={20} label="Vertical dock on the left edge with weather flyout expanded" spec="start w:weather:current w:clock:analog w:focus w:hydration:timer" />
        </div>
        <div class="card-copy">
          <h3>Effortless in vertical orientation.</h3>
          <p>Click any pill to open the full widget flyout sideways. For quick actions like timers and hydration counters, a click triggers them immediately.</p>
        </div>
      </article>

      <article class="card reveal" data-card>
        <div class="card-art">
          <MiniStage id="bloom-b-drag" cycle="reorder" size="large" bloomScale={2.2} bloomOrigin="60% 20%" hue={-26} label="Reordering widgets smoothly along the dock" spec="w:weather:current w:clock:digital w:hydration:timer" />
        </div>
        <div class="card-copy">
          <h3>Drag, drop, arrange.</h3>
          <p>Reorder apps, widgets, and separators with smooth spring physics. When items overflow, scroll effortlessly with your mouse wheel.</p>
        </div>
      </article>

      <article class="card card-wide card-hz reveal" data-card>
        <div class="card-copy">
          <h3>Runs at your display's native speed.</h3>
          <p>Scrolling, transitions, and widget panels render synchronously at your monitor's refresh rate—including 120Hz, 144Hz, and beyond.</p>
        </div>
        <div class="hz" data-hz>
          <div class="hz-read">
            <span class="hz-label">This display</span>
            <span class="hz-value"><b data-hz-value>60</b> Hz</span>
          </div>
          <div class="hz-tracks" aria-hidden="true">
            <div class="hz-track"><span class="hz-name">30 Hz</span><span class="hz-rail"><i data-hz-dot="30"></i></span></div>
            <div class="hz-track is-live"><span class="hz-name">Your display</span><span class="hz-rail"><i data-hz-dot="0"></i></span></div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { initMinis } from '../scripts/minis';
  initMinis();

  const hz = document.querySelector<HTMLElement>('[data-hz]');
  if (hz) {
    const valueEl = hz.querySelector<HTMLElement>('[data-hz-value]')!;
    const dots = [...hz.querySelectorAll<HTMLElement>('[data-hz-dot]')];
    let visible = false;
    let raf = 0;
    let last = 0;
    const samples: number[] = [];
    const start = performance.now();
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loop = (t: number) => {
      if (last) {
        samples.push(t - last);
        if (samples.length > 90) samples.shift();
      }
      last = t;
      if (samples.length > 20) {
        const sorted = [...samples].sort((a, b) => a - b);
        const median = sorted[Math.floor(sorted.length / 2)];
        const rate = 1000 / median;
        const common = [30, 48, 50, 60, 75, 90, 100, 120, 144, 165, 170, 180, 240, 360];
        const snap = common.reduce((a, b) => (Math.abs(b - rate) < Math.abs(a - rate) ? b : a));
        valueEl.textContent = String(snap);
      }
      const p = (((t - start) / 2400) % 1 + 1) % 1;
      const x = 0.5 - 0.5 * Math.cos(p * Math.PI * 2);
      dots.forEach((d) => {
        const fps = Number(d.dataset.hzDot);
        let v = x;
        if (fps) {
          const step = 1000 / fps;
          const tq = Math.floor((t - start) / step) * step;
          const pq = ((tq / 2400) % 1 + 1) % 1;
          v = 0.5 - 0.5 * Math.cos(pq * Math.PI * 2);
        }
        d.style.left = `${v * 100}%`;
      });
      if (visible) raf = requestAnimationFrame(loop);
    };
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      cancelAnimationFrame(raf);
      last = 0;
      if (visible && !still) raf = requestAnimationFrame(loop);
    }).observe(hz);
  }
</script>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 24px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    min-width: 0;
  }
  .card-wide {
    grid-column: span 2;
    grid-template-rows: none;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: stretch;
  }
  .card-copy {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px 26px 26px;
  }
  .card-wide .card-copy {
    align-content: center;
    padding: 36px;
  }
  .card h3 {
    font-size: clamp(1.3rem, 1.9vw, 1.625rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .card p {
    color: var(--text-2);
    font-size: 0.975rem;
    line-height: 1.5;
  }
  .card-art {
    height: 230px;
    padding: 12px 12px 0;
  }
  .card-art :global(.stage-mini) {
    border-radius: 12px 12px 4px 4px;
  }
  .card-wide .card-art {
    height: auto;
    min-height: 330px;
    padding: 12px 12px 12px 0;
  }
  .card-wide .card-art :global(.stage-mini) {
    border-radius: 12px;
  }

  .edge-opts {
    display: flex;
    gap: 4px;
    margin-top: 10px;
    padding: 3px;
    border-radius: 9px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    justify-self: start;
  }
  .edge-opts span {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--text-3);
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }
  .edge-opts span:global(.on) {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .pin-menu {
    position: absolute;
    z-index: 40;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    display: grid;
    gap: 6px;
    justify-items: start;
    scale: 1.15;
    transform-origin: 50% 0;
    transition:
      opacity 300ms var(--ease-out),
      translate 300ms var(--ease-out);
  }
  .pin-menu:global(.is-gone) {
    opacity: 0;
    translate: -50% 10px;
  }
  .pin-file {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 4px;
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: #fff;
    background: rgb(76 194 255 / 0.28);
    box-shadow: inset 0 0 0 1px rgb(76 194 255 / 0.5);
  }
  .pin-file :global(svg) {
    width: 24px;
    height: 24px;
  }
  .pin-menu :global(.flyout) {
    position: relative;
    animation: none;
    margin-left: 26px;
    max-height: none;
    overflow: visible;
  }
  .pin-menu:global(.is-hot) .pin-target {
    background: var(--popup-hover);
    box-shadow: inset 0 0 0 1px rgb(76 194 255 / 0.5);
  }

  .tray-mini :global(.dock) {
    justify-content: flex-end;
  }
  .tray-fly {
    position: absolute;
    right: 150px;
    bottom: 76px;
    animation: none;
    scale: 1.2;
    transform-origin: 50% 100%;
  }
  .tray-fly .tray-grid {
    grid-template-columns: repeat(2, 36px);
  }
  .tg {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
  }
  .tg :global(svg) {
    width: 20px;
    height: 20px;
  }

  .card-hz {
    align-items: center;
  }
  .hz {
    display: grid;
    gap: 22px;
    padding: 30px 36px 30px 0;
  }
  .hz-read {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .hz-label {
    color: var(--text-3);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .hz-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-2);
    font-weight: 600;
  }
  .hz-value b {
    font-size: 3.25rem;
    line-height: 1;
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .hz-tracks {
    display: grid;
    gap: 14px;
  }
  .hz-track {
    display: grid;
    grid-template-columns: 116px 1fr;
    align-items: center;
    height: 48px;
    padding: 0 16px 0 14px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .hz-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-3);
  }
  .hz-rail {
    position: relative;
    height: 30px;
    margin-inline: 15px;
  }
  .hz-rail i {
    position: absolute;
    top: 0;
    left: 0;
    width: 30px;
    height: 30px;
    translate: -50% 0;
    border-radius: 9px;
    background: var(--text-3);
  }
  .is-live .hz-rail i {
    background: var(--accent);
    box-shadow: 0 6px 18px -6px rgb(76 194 255 / 0.8);
  }
  .is-live .hz-name {
    color: var(--text-2);
  }

  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .card-wide {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
    .card-wide .card-copy {
      padding: 24px 24px 8px;
    }
    .card-wide .card-art {
      min-height: 300px;
      padding: 12px;
    }
    .hz {
      padding: 12px 24px 26px;
    }
  }
</style>
