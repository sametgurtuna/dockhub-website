---
import Wordmark from './Wordmark.astro';
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap foot">
    <div class="foot-brand">
      <a class="brand" href="#top" aria-label="DockHub, back to top">
        <Wordmark label={false} />
      </a>
      <p>A modern, fluid, widget-powered dock for Windows. Built with .NET 8 and WPF.</p>
    </div>
    <nav class="foot-cols" aria-label="Footer links">
      <div>
        <h3>Product</h3>
        <a href="#demo">Live Demo</a>
        <a href="#widgets">Widgets</a>
        <a href="#features">Features</a>
        <a href={site.downloadUrl}>Download</a>
      </div>
      <div>
        <h3>Project</h3>
        <a href={site.githubUrl}>GitHub</a>
        <a href={site.readmeUrl}>Documentation</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h3>Credits</h3>
        <a href="https://github.com/cairoshell/ManagedShell" rel="noopener">ManagedShell</a>
        <a href="https://github.com/dremin/RetroBar" rel="noopener">RetroBar</a>
        <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>
      </div>
    </nav>
  </div>
  <div class="wrap foot-legal">
    <p>© {year} DockHub. Weather data provided by Open-Meteo (CC BY 4.0).</p>
    <p>Windows is a trademark of Microsoft Corporation. DockHub is not affiliated with or endorsed by Microsoft.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(72px, 9vw, 120px);
    padding: 56px 0 40px;
    border-top: 1px solid var(--line);
    background: var(--bg-sunk);
  }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 40px;
  }
  .foot-brand {
    display: grid;
    align-content: start;
    gap: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.625rem;
    text-decoration: none;
    justify-self: start;
    border-radius: 6px;
  }
  .foot-brand p {
    color: var(--text-3);
    max-width: 34ch;
    font-size: 0.9375rem;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .foot-cols div {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .foot-cols h3 {
    font-size: 0.875rem;
    color: var(--text);
    margin-bottom: 4px;
  }
  .foot-cols a {
    color: var(--text-3);
    font-size: 0.9375rem;
    text-decoration: none;
    justify-self: start;
    transition: color var(--t-fast);
  }
  .foot-cols a:hover {
    color: var(--text);
  }
  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  @media (max-width: 760px) {
    .foot {
      grid-template-columns: 1fr;
    }
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
