---
import { widgets } from '../scripts/widgets';
import { icons } from '../lib/icons';
import { site } from '../lib/site';

const cats = ['Clocks', 'Productivity', 'Reminders', 'Notes', 'Media', 'System', 'AI', 'Weather'] as const;
const counts = Object.fromEntries(cats.map((c) => [c, widgets.filter((w) => w.category === c).length]));
---

<section class="section" id="widgets">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">Packed with widgets. All built in.</h2>
      <p class="section-lead">
        {widgets.length} widgets, most with several styles. Add any of them as many times as you like; every copy keeps its own settings.
      </p>
    </div>

    <div class="filters reveal" role="tablist" aria-label="Widget categories" data-filters>
      <button type="button" role="tab" aria-selected="true" data-filter="*">All <span>{widgets.length}</span></button>
      {cats.map((c) => <button type="button" role="tab" aria-selected="false" data-filter={c}>{c} <span>{counts[c]}</span></button>)}
    </div>

    <div class="wgrid" data-wgrid>
      {
        widgets.map((w) => (
          <article class="wtile" data-cat={w.category} data-id={w.id} style={`--accent-w2:${w.accent}`}>
            <div class="wtile-stage">
              <div class="stage stage-strip" data-theme="dark" data-size="medium" data-edge="bottom" data-layout="floating" data-mode="replace" data-backdrop="blur" data-phase="ready">
                <div class="strip">
                  <div class="widget-btn" data-preview role="button" tabindex="0" aria-label={`${w.name} preview: click to ${w.variants.length > 1 ? 'cycle style' : 'trigger'}`} />
                </div>
              </div>
            </div>
            <div class="wtile-body">
              <div class="wtile-head">
                <h3>{w.name}</h3>
                <button class="add" type="button" data-add aria-label={`Add ${w.name} to the demo dock`}>
                  <span class="add-ic" set:html={icons.plus} />
                  <span class="add-label">Add</span>
                </button>
              </div>
              <p>{w.description}</p>
              {w.variants.length > 1 && (
                <div class="chips" role="radiogroup" aria-label={`${w.name} styles`}>
                  {w.variants.map((v, i) => (
                    <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-variant={v.id}>
                      {v.name}
                    </button>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
      <article class="wtile-idea">
        <div class="idea-stage" aria-hidden="true">
          <span class="idea-slot"><span set:html={icons.plus} /></span>
        </div>
        <div class="wtile-body">
          <div class="wtile-head">
            <h3>Build your own</h3>
          </div>
          <p>Write a widget with HTML, CSS and JavaScript and share it as a .dockwidget file or a link. Or tell us what your dock is missing.</p>
          <a class="idea-link" href={site.sdkUrl} target="_blank" rel="noopener">
            Widget SDK guide<span set:html={icons.external} />
          </a>
          <a class="idea-link" href={site.issuesUrl} target="_blank" rel="noopener">
            Request a widget<span set:html={icons.external} />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: -16px auto clamp(28px, 4vw, 40px);
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 14px;
    border-radius: 99px;
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--text-2);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }
  .filters button span {
    font-size: 0.8125rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .filters button:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  .filters button[aria-selected='true'] {
    color: var(--accent-ink);
    background: var(--accent);
    box-shadow: none;
  }
  .filters button[aria-selected='true'] span {
    color: rgb(0 19 31 / 0.62);
  }

  .wgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr));
    gap: 16px;
  }
  .wtile,
  .wtile-idea {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    border-radius: 20px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    transition: box-shadow var(--t-med) var(--ease-out);
  }
  .wtile {
    view-transition-class: wtile;
  }
  .wtile:hover,
  .wtile:focus-within {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .wtile[hidden] {
    display: none;
  }

  .wtile-stage {
    padding: 8px 8px 0;
  }
  .wtile-stage :global(.stage-strip) {
    height: 132px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    animation: none;
    transform: none;
    background:
      radial-gradient(110% 90% at 50% 125%, color-mix(in srgb, var(--accent-w2) 30%, transparent), transparent 62%),
      radial-gradient(80% 80% at 15% -15%, rgb(0 103 192 / 0.32), transparent 60%),
      #070b16;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    user-select: none;
  }
  .strip {
    display: flex;
    align-items: center;
    padding: 5px;
    border-radius: 14px;
    background: rgb(27 27 32 / 0.55);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 14px 30px -12px rgb(0 0 0 / 0.6);
    max-width: calc(100% - 20px);
    overflow: hidden;
  }
  @container (max-width: 300px) {
    .strip {
      zoom: 0.88;
    }
  }
  .strip :global(.widget-btn) {
    cursor: pointer;
  }
  .strip :global(.wc) {
    animation: swap 420ms var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  .wtile-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 18px 18px;
  }
  .wtile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 30px;
  }
  .wtile-body h3 {
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .wtile-body p {
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.5;
    padding-right: 2px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
    padding-top: 10px;
  }
  .chips button {
    height: 28px;
    padding: 0 9px;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 540;
    color: var(--text-3);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out);
  }
  .chips button:hover {
    color: var(--text);
  }
  .chips button[aria-checked='true'] {
    color: var(--text);
    background: var(--surface-hover);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .add {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 12px 0 8px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 620;
    color: var(--accent);
    background: rgb(76 194 255 / 0.1);
    transition:
      background-color var(--t-fast) var(--ease-out),
      color var(--t-fast) var(--ease-out);
  }
  .add:hover {
    background: rgb(76 194 255 / 0.18);
  }
  .add-ic {
    display: grid;
    width: 16px;
    height: 16px;
  }
  .add-ic :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 2.2;
  }
  .add:global(.is-done) {
    color: var(--c-green);
    background: rgb(50 215 75 / 0.12);
  }

  .idea-stage {
    display: grid;
    place-items: center;
    height: 132px;
    margin: 8px 8px 0;
    border-radius: 13px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .idea-slot {
    display: grid;
    place-items: center;
    width: 60px;
    height: 50px;
    border-radius: 10px;
    color: var(--text-3);
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.04) 0 6px, transparent 6px 12px);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .idea-slot span {
    display: grid;
    width: 20px;
    height: 20px;
  }
  .idea-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 620;
    color: var(--accent);
    text-decoration: none;
    border-radius: 6px;
  }
  .idea-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .idea-link span {
    display: grid;
    width: 15px;
    height: 15px;
  }

  @media (max-width: 720px) {
    .filters {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filters::-webkit-scrollbar {
      display: none;
    }
    .filters button {
      flex: none;
    }
  }

  /* On phones the gallery becomes a swipeable row instead of twenty stacked cards. */
  @media (max-width: 640px) {
    .wgrid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(84%, 320px);
      gap: 12px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 2px var(--gutter) 8px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .wgrid::-webkit-scrollbar {
      display: none;
    }
    .wtile,
    .wtile-idea {
      scroll-snap-align: start;
    }
  }
</style>
