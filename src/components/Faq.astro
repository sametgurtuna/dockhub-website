---
import { icons } from '../lib/icons';
import { site } from '../lib/site';

const faqs = [
  {
    q: 'What happens to my Windows taskbar?',
    a: 'In "Replace" mode, the taskbar is smoothly hidden and set to auto-hide; Explorer is never terminated. When DockHub exits, crashes, or during logoff, your taskbar immediately returns to its original state. In "Both together" mode, the Windows taskbar is left completely untouched.',
  },
  {
    q: 'Does DockHub require administrator privileges?',
    a: 'No. DockHub runs purely as a standard user process. Running as administrator is actually discouraged, because Windows prevents drag-and-drop between unelevated Explorer windows and elevated processes.',
  },
  {
    q: 'What if the app crashes or is forcibly killed?',
    a: 'The built-in crash handler restores the taskbar before the process exits. In the event of a sudden power loss or force-kill via Task Manager, the taskbar remains in auto-hide mode and will slide open when your mouse hovers the screen edge. On your next session or by running "DockHub.exe --restore-taskbar", the original state is cleanly restored.',
  },
  {
    q: 'Which Windows versions are supported?',
    a: 'Windows 10 1809 (build 17763) and higher. For rounded corners and Mica blur materials, Windows 11 22H2 or newer is recommended. The installer bundles all required .NET runtime components—no prerequisites needed.',
  },
  {
    q: 'Does it launch automatically on startup?',
    a: 'Yes. By default, the installer configures DockHub to start with Windows. You can easily toggle this off during installation or at any time in Settings › General.',
  },
  {
    q: 'How do I add widgets and change their appearance?',
    a: 'Right-click any empty space on the dock and select "Add widget", or browse the Widget Gallery in Settings and click the "+" button. To change a widget\'s style, right-click it directly on the dock and choose an option from the "Appearance" submenu.',
  },
  {
    q: 'Does it use an internet connection?',
    a: 'Internet access is used solely for the weather widget (via Open-Meteo) and geocoding city search. No API keys or accounts are required, and no telemetry, tracking, or personal data is ever collected or sent.',
  },
  {
    q: 'Where are my settings stored?',
    a: 'All preferences and dock configurations reside in %AppData%\\DockHub\\config.json. User data such as notes, reminders, and hydration counters are kept in the data subfolder. Files are written atomically using safe temp files to prevent corruption.',
  },
  {
    q: 'Do the Windows 11 network, volume, and battery flyouts work?',
    a: 'DockHub displays native tray counterparts right on the dock. You can access Windows\' native Quick Settings panel by right-clicking the clock or dock, or by pressing Win+A.',
  },
  {
    q: 'Does it support multi-monitor setups?',
    a: 'Yes. DockHub displays on your designated monitor of choice, with full per-monitor DPI scaling support.',
  },
  {
    q: 'Can I use it alongside StartAllBack or ExplorerPatcher?',
    a: 'It is not recommended. Running multiple third-party tools that hook or modify the Windows taskbar simultaneously can cause conflicts.',
  },
  {
    q: 'Is it completely free?',
    a: 'Yes. DockHub is 100% free and open source under the MIT license.',
  },
];
---

<section class="section" id="faq">
  <div class="wrap faq">
    <div class="faq-head reveal">
      <h2 class="section-title">Frequently asked questions.</h2>
      <p class="section-lead">Can't find the answer you're looking for?</p>
      <a class="btn btn-quiet faq-cta" href={site.githubUrl}>
        <span set:html={icons.github} />
        Ask on GitHub
      </a>
    </div>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details class="qa reveal">
            <summary>
              <span>{f.q}</span>
              <span class="qa-ic" set:html={icons.plus} />
            </summary>
            <div class="qa-body">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq-head {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 100px;
  }
  .faq-head .section-title {
    max-width: 10ch;
  }
  .faq-cta {
    margin-top: 6px;
    --btn-h: 44px;
  }
  .faq-cta span {
    width: 18px;
    height: 18px;
    display: grid;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  .qa {
    border-bottom: 1px solid var(--line);
    --reveal-y: 12px;
  }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    border-radius: 6px;
    transition: color var(--t-fast);
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary:hover {
    color: var(--accent);
  }
  .qa-ic {
    flex: none;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface-hover);
    color: var(--text-2);
    transition:
      rotate var(--t-slow) var(--ease-out),
      background-color var(--t-fast),
      color var(--t-fast);
  }
  .qa-ic :global(svg) {
    width: 15px;
    height: 15px;
  }
  .qa[open] .qa-ic {
    rotate: 45deg;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .qa-body {
    padding: 0 60px 24px 4px;
  }
  .qa-body p {
    color: var(--text-2);
    max-width: 62ch;
  }
  .qa::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 380ms var(--ease-out),
      content-visibility 380ms allow-discrete;
  }
  .qa[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    :global(:root) {
      interpolate-size: allow-keywords;
    }
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
    }
    .faq-head .section-title {
      max-width: 14ch;
    }
    .qa-body {
      padding-right: 8px;
    }
  }
</style>
