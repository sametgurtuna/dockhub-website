---
import Bloom from './Bloom.astro';
import { icons, windowsLogo, dockLogo } from '../lib/icons';
import { appIcons } from '../lib/apps';

const tbApps = ['explorer', 'browser', 'terminal', 'notepad'] as const;
---

<div class="stage-shell" data-stage-shell>
  <div
    class="stage"
    data-stage
    data-theme="dark"
    data-edge="bottom"
    data-layout="floating"
    data-size="small"
    data-mode="replace"
    data-backdrop="blur"
    data-phase="boot"
    role="application"
    aria-roledescription="DockHub live demo"
    aria-label="DockHub demo running on Windows 11 desktop"
  >
    <Bloom id="bloom-stage" />

    <div class="desk-icons" data-desk-icons>
      <button class="desk-icon" data-open="pc" type="button">
        <span class="desk-icon-img" set:html={appIcons.pc} />
        <span>This PC</span>
      </button>
      <button class="desk-icon" data-open="bin" type="button">
        <span class="desk-icon-img" set:html={appIcons.bin} />
        <span>Recycle Bin</span>
      </button>
      <button class="desk-icon" data-open="dock-settings" type="button">
        <span class="desk-icon-img" set:html={dockLogo('dl-desk')} />
        <span>DockHub</span>
      </button>
    </div>

    <div class="windows-layer" data-windows></div>

    <div class="win-taskbar" data-win-taskbar aria-hidden="true">
      <div class="wtb-left">
        <span class="wtb-weather"><span class="wtb-sun"></span><span><b>18°C</b><small>Partly cloudy</small></span></span>
      </div>
      <div class="wtb-center">
        <span class="wtb-btn wtb-start" set:html={windowsLogo('wl-tb')} />
        <span class="wtb-btn wtb-search"><span set:html={icons.search} /><span>Search</span></span>
        <span class="wtb-btn" set:html={icons.taskView} />
        {tbApps.map((a) => <span class="wtb-btn wtb-app" set:html={appIcons[a]} />)}
      </div>
      <div class="wtb-right">
        <span class="wtb-ic" set:html={icons.chevronUp} />
        <span class="wtb-ic" set:html={icons.wifi} />
        <span class="wtb-ic" set:html={icons.volume} />
        <span class="wtb-ic" set:html={icons.battery} />
        <span class="wtb-clock" data-clock-tb><span>--:--</span><span>--/--/----</span></span>
      </div>
    </div>

    <nav class="dock" data-dock aria-label="DockHub">
      <div class="dock-zone dock-start">
        <button class="db db-start" type="button" data-start aria-label="Start" set:html={windowsLogo('wl-dock')} />
        <button class="db db-icon" type="button" data-search aria-label="Search" set:html={icons.search} />
      </div>
      <div class="dock-center">
        <button class="dock-arrow dock-arrow-prev" type="button" tabindex="-1" aria-label="Scroll left" data-scroll="-1" set:html={icons.chevronLeft} />
        <div class="dock-scroll" data-dock-scroll>
          <div class="dock-items" data-dock-items></div>
        </div>
        <button class="dock-arrow dock-arrow-next" type="button" tabindex="-1" aria-label="Scroll right" data-scroll="1" set:html={icons.chevronRight} />
      </div>
      <div class="dock-zone dock-end">
        <div class="dock-tray" data-tray>
          <button class="db db-tray" type="button" data-tray-more aria-label="Show hidden icons" set:html={icons.chevronUp} />
          <button class="db db-tray" type="button" data-quick aria-label="Network, sound and battery" >
            <span set:html={icons.wifi} /><span set:html={icons.volume} /><span set:html={icons.battery} />
          </button>
        </div>
        <button class="db db-clock" type="button" data-clock aria-label="Clock and notifications">
          <span data-clock-time>--:--</span>
          <span data-clock-date>--/--/----</span>
        </button>
        <button class="db-desktop" type="button" data-show-desktop aria-label="Show desktop"></button>
      </div>
    </nav>

    <div class="edge-hint" data-edge-hint>Move pointer to screen edge to reveal dock</div>
    <div class="layer" data-layer></div>
    <div class="toasts" data-toasts aria-live="polite"></div>
  </div>
  {Astro.slots.has('overlay') && (
    <div class="stage-overlay">
      <slot name="overlay" />
    </div>
  )}
</div>

{Astro.slots.has('between') && <slot name="between" />}

<div class="demo-bar" data-demo-bar>
  <div class="seg-group">
    <span class="seg-label" id="lbl-mode">Mode</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-mode" data-control="mode">
      <button type="button" role="radio" data-value="replace">Replace</button>
      <button type="button" role="radio" data-value="both">Both</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-edge">Position</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-edge" data-control="edge">
      <button type="button" role="radio" data-value="bottom">Bottom</button>
      <button type="button" role="radio" data-value="left">Left</button>
      <button type="button" role="radio" data-value="right">Right</button>
      <button type="button" role="radio" data-value="top">Top</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-layout">Layout</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-layout" data-control="layout">
      <button type="button" role="radio" data-value="floating">Floating</button>
      <button type="button" role="radio" data-value="attached">Attached</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-theme">Theme</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-theme" data-control="theme">
      <button type="button" role="radio" data-value="dark">Dark</button>
      <button type="button" role="radio" data-value="light">Light</button>
    </div>
  </div>
  <div class="demo-bar-actions">
    <button class="bar-btn bar-btn-accent" type="button" data-add-widget>
      <span set:html={icons.widgets} />Add widget
    </button>
    <button class="bar-btn" type="button" data-open-settings>
      <span set:html={icons.settings} />All settings
    </button>
  </div>
</div>

<script>
  import { initDemo } from '../scripts/demo';
  initDemo();
</script>
