---
import Desktop from './Desktop.astro';
import { icons } from '../lib/icons';
import { site } from '../lib/site';
import { widgets } from '../scripts/widgets';
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-head">
    <h1 class="hero-title">
      <span class="line"><span>Your taskbar,</span></span>
      <span class="line"><span>rebuilt as a dock.</span></span>
    </h1>

    <div class="hero-side">
      <p class="hero-lead">
        DockHub swaps the Windows taskbar for a glass dock with your apps, tray, clock and {widgets.length} live widgets. Close it and the
        taskbar comes straight back.
      </p>

      <div class="hero-cta">
        <a class="btn btn-primary btn-hero" href={site.downloadUrl}>
          <span class="btn-ic" set:html={icons.download} />
          <span>Download for Windows</span>
        </a>
        <a class="btn btn-quiet btn-hero" href={site.githubUrl} target="_blank" rel="noopener">
          <span class="btn-ic" set:html={icons.github} />
          <span>GitHub</span>
        </a>
      </div>

      <ul class="hero-meta" aria-label="At a glance">
        <li><span class="meta-ic" set:html={icons.check} />Free and open source</li>
        <li><span class="meta-ic" set:html={icons.check} />No admin rights needed</li>
        <li><span class="meta-ic" set:html={icons.check} />Windows 10 and 11</li>
        <li>
          <a href={site.releaseUrl} target="_blank" rel="noopener">
            <span class="meta-ic" set:html={icons.arrowRight} />What's new in v{site.version}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap hero-stage" id="demo">
    <Desktop />
    <p class="fine demo-note">
      A live demo running in your browser: click widgets, right-click for menus, drag to reorder. The clock is real; weather,
      system stats, music and meetings are simulated.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(20px, 3.2vh, 40px);
  }

  .hero-glow {
    position: absolute;
    inset: -68px 0 auto;
    height: 1100px;
    background:
      radial-gradient(48% 36% at 22% 8%, rgb(0 103 192 / 0.26), transparent 70%),
      radial-gradient(60% 40% at 50% 62%, rgb(29 111 255 / 0.16), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .hero-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    align-items: end;
    gap: 28px clamp(32px, 5vw, 72px);
    margin-bottom: clamp(24px, 3.2vh, 36px);
  }

  .hero-title {
    font-size: clamp(2.75rem, 5.6vw, 5.25rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: nowrap;
  }
  .line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.04em;
  }
  .line > span {
    display: inline-block;
  }
  .line + .line > span {
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 900ms var(--ease-out) both;
    }
    .line + .line > span {
      animation-delay: 90ms;
    }
    .hero-side {
      animation: fade 900ms var(--ease-out) 220ms both;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .hero-side {
    display: grid;
    gap: 20px;
    padding-bottom: 0.35rem;
  }

  .hero-lead {
    font-size: clamp(1.0625rem, 1.25vw, 1.1875rem);
    line-height: 1.5;
    color: var(--text-2);
    max-width: 40ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn-hero {
    --btn-h: 50px;
    padding-inline: 22px;
  }
  .btn-ic {
    display: grid;
    width: 18px;
    height: 18px;
  }
  .btn-ic :global(svg) {
    width: 100%;
    height: 100%;
  }
  .btn-primary .btn-ic :global(svg) {
    stroke-width: 2;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-3);
  }
  .hero-meta li,
  .hero-meta a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-meta a {
    color: var(--text-2);
    text-decoration: none;
    border-radius: 4px;
    transition: color var(--t-fast) var(--ease-out);
  }
  .hero-meta a:hover {
    color: var(--accent);
  }
  .meta-ic {
    display: grid;
    width: 15px;
    height: 15px;
    color: var(--text-3);
    transition: translate var(--t-med) var(--ease-out);
  }
  .meta-ic :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 2;
  }
  .hero-meta a .meta-ic {
    color: var(--accent);
  }
  .hero-meta a:hover .meta-ic {
    translate: 3px 0;
  }

  .hero-stage {
    position: relative;
    scroll-margin-top: 84px;
  }
  /* Sized so the whole desktop, dock included, lands inside the first viewport. */
  .hero-stage :global(.stage) {
    height: clamp(500px, calc(100svh - 372px), 760px);
  }

  .demo-note {
    max-width: 62ch;
    margin: 16px auto 0;
    text-align: center;
  }

  @media (max-width: 1023px) {
    .hero-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-title {
      text-wrap: balance;
    }
    .hero-side {
      padding-bottom: 0;
    }
    .hero-lead {
      max-width: 52ch;
    }
    .hero-stage :global(.stage) {
      height: clamp(480px, 62vh, 640px);
    }
  }

  @media (max-width: 560px) {
    .hero-title {
      font-size: clamp(1.875rem, 10vw, 3.25rem);
      text-wrap: nowrap;
    }
    .hero-cta > * {
      flex: 1 1 100%;
    }
    .hero-meta {
      grid-template-columns: 1fr;
    }
    .hero-stage :global(.stage) {
      height: 520px;
    }
  }
</style>
