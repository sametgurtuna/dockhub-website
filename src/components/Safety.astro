---
import MiniStage from './MiniStage.astro';
import { icons } from '../lib/icons';

const scenarios = [
  {
    id: 'exit',
    title: 'Normal Exit',
    text: 'When closing via the dock menu, tray, or --exit, the Windows taskbar and system tray icons reappear immediately.',
  },
  {
    id: 'logoff',
    title: 'Signing Out',
    text: 'Before Windows finishes logging off or shutting down, DockHub restores the taskbar. Everything is in order on your next login.',
  },
  {
    id: 'crash',
    title: 'Unexpected Crash',
    text: 'If an unhandled exception occurs, the crash handler restores the taskbar before terminating. You are never left without a desktop.',
  },
  {
    id: 'kill',
    title: 'Forced Process Kill',
    text: 'If terminated via Task Manager or a power cut, the taskbar remains in auto-hide mode and reveals when hovering the bottom edge. On next launch, original state is fully restored.',
  },
];

const facts = [
  { title: 'No administrator privileges required', text: 'Runs as a standard user process. Explorer.exe is never terminated or injected.' },
  { title: 'Atomic configuration writes', text: 'Settings are written to a temp file and moved atomically. Corrupted files are safely backed up.' },
  { title: 'Network access strictly for weather', text: 'The only outbound HTTP requests query Open-Meteo. No user telemetry, accounts, or tracking.' },
] as const;
---

<section class="section" id="safety">
  <div class="wrap">
    <div class="safety">
      <div class="safety-copy reveal">
        <h2 class="section-title">Your taskbar is always one step away.</h2>
        <p class="section-lead">No matter what happens, DockHub ensures Windows returns to its pristine state. Pick a scenario below to watch how it recovers.</p>

        <div class="scenarios" role="tablist" aria-label="Recovery scenarios" data-scenarios>
          {
            scenarios.map((s, i) => (
              <button type="button" role="tab" class="scn" aria-selected={i === 0 ? 'true' : 'false'} data-scn={s.id}>
                <span class="scn-title">{s.title}</span>
                <span class="scn-text">{s.text}</span>
                <span class="scn-bar" aria-hidden="true"><i /></span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="safety-art reveal">
        <MiniStage
          id="bloom-safety"
          taskbar
          size="medium"
          label="Windows taskbar restoring when DockHub exits"
          spec="start app:explorer:active app:browser app:terminal sep w:clock:analog w:media:compact w:weather:current tray clock"
          class="safety-stage"
        >
          <div class="scn-overlay" data-scn-overlay>
            <span class="scn-spinner" aria-hidden="true"></span>
            <span>Signing out</span>
          </div>
          <div class="scn-toast flyout" data-scn-toast>
            <b>DockHub</b>
            <span data-scn-toast-text></span>
          </div>
          <span class="mini-cursor scn-cursor" data-scn-cursor set:html={`<svg viewBox="0 0 18 22"><path d="M1.5 1.5v16.2l4.2-4 2.9 6.6 3-1.3-2.9-6.5h5.8z" fill="#fff" stroke="#111" stroke-width="1.2" stroke-linejoin="round"/></svg>`} />
        </MiniStage>

        <div class="cmd">
          <span class="cmd-label">Emergency one-line recovery</span>
          <div class="cmd-line">
            <code>DockHub.exe --restore-taskbar</code>
            <button type="button" class="cmd-copy" data-copy="DockHub.exe --restore-taskbar" aria-label="Copy command">
              <span class="cmd-ic" set:html={icons.copy} />
              <span class="cmd-state">Copy</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <dl class="facts reveal">
      {
        facts.map((f) => (
          <div>
            <dt>{f.title}</dt>
            <dd>{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-scenarios]');
  const stage = document.querySelector<HTMLElement>('.safety-stage');
  if (root && stage) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-scn]')];
    const overlay = stage.querySelector<HTMLElement>('[data-scn-overlay]')!;
    const toast = stage.querySelector<HTMLElement>('[data-scn-toast]')!;
    const toastText = stage.querySelector<HTMLElement>('[data-scn-toast-text]')!;
    const cursor = stage.querySelector<HTMLElement>('[data-scn-cursor]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('static');
    const DURATION = 6200;
    let current = 0;
    let timers: number[] = [];
    let auto = !still;
    let visible = false;

    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      stage.dataset.phase = 'ready';
      stage.classList.remove('is-crashing', 'is-killed', 'tb-peek', 'tb-shown', 'is-dim');
      overlay.classList.remove('on');
      toast.classList.remove('on');
      cursor.classList.remove('at-edge');
    };

    const play = (i: number) => {
      reset();
      current = i;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
        t.classList.remove('is-playing');
      });
      const tab = tabs[i];
      void tab.offsetWidth;
      if (auto) tab.classList.add('is-playing');
      const id = tab.dataset.scn;
      const note = (text: string) => {
        toastText.textContent = text;
        toast.classList.add('on');
      };
      if (still) {
        stage.dataset.phase = id === 'kill' ? 'ready' : 'exited';
        if (id === 'kill') stage.classList.add('is-killed', 'tb-peek', 'tb-shown');
        if (id !== 'logoff') note(id === 'kill' ? 'Original taskbar state will be restored on next launch.' : 'Taskbar and tray icons restored.');
        return;
      }
      if (id === 'exit') {
        later(700, () => (stage.dataset.phase = 'exited'));
        later(1500, () => note('Exited. Taskbar and tray icons restored.'));
      } else if (id === 'logoff') {
        later(500, () => {
          stage.classList.add('is-dim');
          overlay.classList.add('on');
        });
        later(1600, () => (stage.dataset.phase = 'exited'));
        later(2800, () => {
          overlay.classList.remove('on');
          stage.classList.remove('is-dim');
        });
      } else if (id === 'crash') {
        later(600, () => stage.classList.add('is-crashing'));
        later(1300, () => {
          stage.classList.remove('is-crashing');
          stage.dataset.phase = 'exited';
        });
        later(2000, () => note('An unexpected error occurred. Taskbar restored.'));
      } else {
        later(600, () => stage.classList.add('is-killed', 'tb-peek'));
        later(1800, () => cursor.classList.add('at-edge'));
        later(2700, () => stage.classList.add('tb-shown'));
        later(3600, () => note('session.json read on next launch, original state restored.'));
      }
      if (auto) later(DURATION, () => visible && play((current + 1) % tabs.length));
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        auto = false;
        play(i);
      }),
    );
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const n = (current + (e.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
      tabs[n].focus();
      tabs[n].click();
    });

    if (still) play(0);
    new IntersectionObserver(
      ([en]) => {
        visible = en.isIntersecting;
        if (still) return;
        if (visible) play(current);
        else reset();
      },
      { threshold: 0.35 },
    ).observe(stage);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const state = b.querySelector('.cmd-state')!;
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        state.textContent = 'Copied';
      } catch {
        state.textContent = 'Failed to copy';
      }
      setTimeout(() => (state.textContent = 'Copy'), 1800);
    }),
  );
</script>

<style>
  .safety {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .safety-copy {
    display: grid;
    gap: 18px;
    position: sticky;
    top: 100px;
  }
  .safety-copy .section-title {
    max-width: 13ch;
  }
  .scenarios {
    display: grid;
    gap: 4px;
    margin-top: 18px;
  }
  .scn {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 18px 18px;
    border-radius: 14px;
    text-align: start;
    color: var(--text-2);
    transition:
      background-color var(--t-med) var(--ease-out),
      color var(--t-med) var(--ease-out);
  }
  .scn:hover {
    background: var(--surface);
  }
  .scn-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .scn-text {
    display: grid;
    grid-template-rows: 0fr;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 400ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }
  .scn[aria-selected='true'] {
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .scn[aria-selected='true'] .scn-title {
    color: var(--text);
  }
  .scn[aria-selected='true'] .scn-text {
    max-height: 7.5em;
    opacity: 1;
  }
  .scn-bar {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 8px;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
  }
  .scn-bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .scn.is-playing .scn-bar {
    opacity: 1;
  }
  .scn.is-playing .scn-bar i {
    animation: scn-progress 6200ms linear forwards;
  }
  @keyframes scn-progress {
    to {
      transform: scaleX(1);
    }
  }

  .safety-art {
    display: grid;
    gap: 16px;
  }
  .safety-art :global(.safety-stage) {
    height: clamp(340px, 34vw, 460px);
  }
  :global(.safety-stage .bloom) {
    transition: filter 600ms var(--ease-out);
  }
  :global(.safety-stage.is-dim .bloom) {
    filter: brightness(0.35) saturate(0.6);
  }
  :global(.safety-stage.is-crashing .dock) {
    animation: crash 700ms steps(8) both;
  }
  @keyframes crash {
    0%,
    100% {
      translate: 0 0;
      filter: none;
    }
    20% {
      translate: -6px 0;
      filter: hue-rotate(90deg) contrast(1.6);
    }
    40% {
      translate: 5px -2px;
      filter: grayscale(1);
      opacity: 0.6;
    }
    60% {
      translate: -3px 2px;
      filter: invert(0.2);
    }
    80% {
      translate: 4px 0;
      opacity: 0.3;
    }
  }
  :global(.safety-stage.is-killed .dock) {
    opacity: 0;
    visibility: hidden;
    transition: none;
  }
  :global(.safety-stage.tb-peek .win-taskbar) {
    transform: translateY(calc(100% - 3px));
    transition: transform 400ms var(--ease-out);
  }
  :global(.safety-stage.tb-peek.tb-shown .win-taskbar) {
    transform: none;
  }
  .scn-overlay {
    position: absolute;
    inset: 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: #fff;
    font-family: var(--font-ui);
    font-size: 1.25rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }
  .scn-overlay:global(.on) {
    opacity: 1;
  }
  .scn-spinner {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 3px solid rgb(255 255 255 / 0.25);
    border-top-color: #fff;
    animation: spin 900ms linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  .scn-toast {
    position: absolute;
    right: 14px;
    bottom: 62px;
    z-index: 46;
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    width: min(290px, calc(100% - 28px));
    font-family: var(--font-ui);
    font-size: 12.5px;
    opacity: 0;
    translate: 24px 0;
    animation: none;
    transition:
      opacity 300ms var(--ease-out),
      translate 400ms var(--ease-out);
  }
  .scn-toast b {
    font-size: 11.5px;
    color: var(--w-text-2);
    font-weight: 600;
  }
  .scn-toast:global(.on) {
    opacity: 1;
    translate: 0 0;
  }
  .scn-cursor {
    left: 46%;
    top: 30%;
  }

  .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 14px 14px 14px 20px;
    border-radius: 14px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cmd-label {
    color: var(--text-3);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .cmd-line {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  code {
    font-family: 'Cascadia Mono', Consolas, ui-monospace, monospace;
    font-size: 0.9375rem;
    color: var(--accent);
    user-select: all;
    overflow-wrap: anywhere;
  }
  .cmd-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface-hover);
    box-shadow: inset 0 0 0 1px var(--line);
    flex: none;
  }
  .cmd-copy:hover {
    color: var(--text);
  }
  .cmd-ic {
    width: 15px;
    height: 15px;
    display: grid;
  }

  .facts {
    margin: clamp(56px, 7vw, 88px) 0 0;
    padding: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 48px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .facts dd {
    margin: 0;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .safety {
      grid-template-columns: 1fr;
    }
    .safety-copy {
      position: static;
    }
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
